rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOfficer() {
      return isAuthenticated() && exists(/databases/$(database)/documents/officers/$(request.auth.uid));
    }

    // 1. User Profiles
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if isOwner(userId);
    }

    // 2. Local Equipment Listings
    // Visible to signed-in users. Phone number permitted only if consentPhoneShare is true.
    match /equipment_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.equipmentName, 2, 100)
        && isValidString(request.resource.data.village, 2, 80)
        && isValidString(request.resource.data.district, 2, 80)
        && request.resource.data.consentPhoneShare is bool
        && (request.resource.data.consentPhoneShare == true || !('phone' in request.resource.data) || request.resource.data.phone == "")
        && request.resource.data.size() <= 20;
      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // 3. Farmer Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.recommendationId, 1, 100)
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.size() <= 20;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Disease Scan Confirmations (Future Retraining Loop)
    match /diagnosis_confirmations/{scanId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOfficer());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.farmerVerdict in ['CONFIRMED', 'REJECTED', 'UNCERTAIN']
        && isValidString(request.resource.data.predictedDisease, 1, 100)
        && request.resource.data.size() <= 25;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Community Posts
    match /community_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 1000)
        && request.resource.data.size() <= 15;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 6. Farmer Verdicts (Field Accuracy & Drift Monitoring)
    // Rules: Visible to all signed-in users and officers for analytics.
    match /verdicts/{verdictId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.verdict in ['YES', 'NO', 'NOT_SURE']
        && isValidString(request.resource.data.predictedClass, 1, 100)
        && request.resource.data.calibratedConfidence is number
        && request.resource.data.tier in ['TIER_1_CONFIDENT', 'TIER_2_MODERATE', 'TIER_3_INCONCLUSIVE']
        && request.resource.data.size() <= 25;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 7. Extension Officers (Role-Based Access without Cloud Functions)
    // Document ID = user uid. Only admin / owner can add or edit officers in Firebase Console.
    match /officers/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Console-only modification
    }

    // 8. Field Diagnoses & Compressed Photo Thumbnails
    // Normal users can read only their own. Verified officers can read all for triage.
    match /diagnoses/{diagnosisId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOfficer());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.crop, 1, 50)
        && isValidString(request.resource.data.predictedClass, 1, 100)
        && (!('thumbnailBase64' in request.resource.data) || (
          request.resource.data.photoConsent == true &&
          request.resource.data.thumbnailBase64.size() <= 65536
        ))
        && request.resource.data.size() <= 30;
      allow update: if false; // Immutable audit log
      allow delete: if isOwner(resource.data.userId); // Farmer right to erasure (DPDP Act)
    }

    // 9. Expert Ground Truth Labels (Dual-Agronomist Research Dataset)
    // Only verified extension officers can submit expert pathogen labels.
    match /expert_labels/{labelId} {
      allow read: if isAuthenticated();
      allow create: if isOfficer()
        && request.resource.data.officerId == request.auth.uid
        && isValidString(request.resource.data.diagnosisId, 1, 100)
        && isValidString(request.resource.data.verifiedPathogen, 1, 100)
        && request.resource.data.size() <= 20;
      allow update: if isOfficer() && resource.data.officerId == request.auth.uid;
      allow delete: if false;
    }
  }
}
